DATABASE_URL=postgresql://cortex:cortex@localhost:5432/cortex
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
EMBED_BATCH_SIZE=64
CHUNK_TARGET_TOKENS=350
CHUNK_MAX_TOKENS=480
CHUNK_OVERLAP_TOKENS=40
BGE_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages:

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_DISABLE_THINKING=true
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=800
CHAT_TIMEOUT_S=60.0
CHAT_MAX_RETRIES=2

RETRIEVAL_K=6
RETRIEVAL_CANDIDATES=20
RETRIEVAL_HYBRID=true
RRF_CANDIDATES=50
RRF_K=60
CHAT_CONTEXT_CHAR_CAP=6000

# --- Deployment (see DEPLOY.md) ---
# Browser origins allowed to call the API. "*" allows any origin (fine for this
# cookieless read API). In production narrow it to your deployed frontend, e.g.
# CORS_ALLOW_ORIGINS=https://your-app.vercel.app
CORS_ALLOW_ORIGINS=*
# Domain Caddy serves HTTPS on (production only; used by docker-compose.prod.yml).
# Must point at the host via a DNS A record. e.g. CORTEX_DOMAIN=api.example.com
CORTEX_DOMAIN=
