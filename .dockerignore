# Keep the build context small and secrets out of the image.
.git
.github
.venv
venv
env

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Frontend is built/served separately.
frontend/node_modules/
frontend/dist/
node_modules/

# Local secrets — provided at runtime via the compose bind mount, never baked in.
.env
.env.*
!.env.example

# Docs and editor cruft.
*.md
!README.md
.claude/
.idea/
.vscode/
.DS_Store
